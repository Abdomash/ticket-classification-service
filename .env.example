POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tickets
LOG_LEVEL=INFO

LLM_PROVIDER=fake # fake | openai_compat
LLM_BASE_URL=https://openrouter.ai/api/v1
# Required unless LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=openai/gpt-6-luna
LLM_TIMEOUT_SECONDS=30
FAKE_FAILURE_RATE=0.05
FAKE_SEED=42

WORKER_CONCURRENCY=4 # Concurrent classifications per worker process
MAX_ATTEMPTS=3
POLL_SECONDS=1
